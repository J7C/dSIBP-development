(* ::Package:: *)

(***
文件：check_module_ownership.wls
用途：dSIBP H5 静态回归检查。扫描指定版本 Kernel 目录的 .wl 源码，提取顶层
      ``name[...] :=`` 定义左端，报告"同一精确左端"在多个文件重复定义的情况，
      并生成模块所有权表（符号 -> 定义文件，首次出现为准）。
运行：wolframscript -file package-dSibp/check-smoke/check_module_ownership.wls [versionDir]
边界：只读源码，不加载 package、不执行定义；只匹配行首（列 0）开头的顶层定义。
      允许公开短签名（不同参数模式）与明确声明的扩展 DownValue；本检查只禁止
      未登记的同签名重复定义。
***)

projectRoot = ExpandFileName[FileNameJoin[{DirectoryName[$InputFileName], "..", ".."}]];
versionDir = With[{dirs = Select[$ScriptCommandLine, StringQ[#] && DirectoryQ[#] &]},
  If[dirs =!= {},
    ExpandFileName[First[dirs]],
    FileNameJoin[{projectRoot, "versions", "022_dSIBP"}]
  ]
];
kernelDir = FileNameJoin[{versionDir, "Kernel"}];
If[! DirectoryQ[kernelDir],
  Print["Kernel directory does not exist: ", kernelDir]; Exit[2]
];

files = FileNames["*.wl", kernelDir, Infinity];
Print["Scanned Kernel files: ", Length[files]];

(* 顶层定义左端：行首（列 0）的 name[...] 且该行含 := 或 :>，并排除注释与消息定义。
   多行定义只取函数名与左端首行；签名比较用"函数名 + 参数模式串"。 *)
leftWhole = RegularExpression["^\\$?[A-Za-z][A-Za-z0-9]*\\s*\\[[^\\]]*\\]\\s*:?="];
namePart = RegularExpression["^\\$?[A-Za-z][A-Za-z0-9]*"];
argsPart = RegularExpression["\\[[^\\]]*\\]"];

definitions = <||>;  (* name -> <|file -> {lefts,...}|> *)
scanText[file_String] := Module[{lines, whole, name, bracket},
  lines = Import[file, "Lines"];
  Do[
    whole = StringCases[line, leftWhole];
    If[whole =!= {} &&
       StringFreeQ[line, "::"] && StringFreeQ[line, "(*"] && StringFreeQ[line, "Module["],
      name = First@StringCases[First[whole], namePart];
      bracket = First@StringCases[First[whole], argsPart];
      AssociateTo[definitions, name -> Append[Lookup[definitions, name, <||>], file -> name <> bracket]]
    ],
    {line, lines}
  ]
];

Scan[scanText, files];

(* 模块所有权表：名字 -> 首次定义文件（相对版本目录，正向斜杠，便于跨机器复用） *)
ownership = Association@KeyValueMap[
  Function[{name, byFile},
    name -> StringReplace[
      FileNameTake[First@Keys[byFile], -2] // FileNameJoin,
      "\\" -> "/"
    ]
  ],
  definitions
];
ownershipTableFile = FileNameJoin[{DirectoryName[$InputFileName], "module_ownership_022.wl"}];
stream = OpenWrite[ownershipTableFile, BinaryFormat -> True];
WriteString[stream,
  "(* Module ownership table: dSIBP 022 Kernel symbols -> first defining file (relative to the\n" <>
  "   version root). Generated by check_module_ownership.wls; do not edit by hand. *)\n" <>
  StringRiffle[
    KeyValueMap[Function[{name, file}, name <> " -> \"" <> file <> "\""], ownership],
    "\n"
  ] <> "\n"
];
Close[stream];
Print["Module ownership table: ", Length[ownership], " top-level symbols -> ", ownershipTableFile];

(* 同左端覆盖：同一 name 在同一签名（pattern 串）出现在多个文件 *)
violations = Association@KeyValueMap[
  Function[{name, byFile},
    With[{groups = GroupBy[Values[byFile], Identity]},
      name -> Select[groups, Length[#] > 1 &]
    ]
  ],
  definitions
];
violations = Select[violations, Length[#] > 0 &];

If[violations === <||>,
  Print["H5 duplicate-definition audit: passed"],
  Print["H5 duplicate-definition audit: ", Length[violations], " cross-file duplicate signatures:"];
  KeyValueMap[
    Function[{name, groups},
      Print["  ", name, ":"];
      KeyValueMap[
        Function[{pattern, fileList},
          Print["    ", pattern, " -> ", StringRiffle[fileList, ", "]]
        ],
        groups
      ]
    ],
    violations
  ];
  Exit[1]
];
